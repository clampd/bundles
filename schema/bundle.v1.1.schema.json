{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clampd/bundles/schema/bundle.v1.1.schema.json",
  "title": "Clampd Bundle v1.1",
  "description": "A curated set of detection rules, keywords, sample agents, policy templates, and protected entities for a specific AI agent type, framework, or compliance regime.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "category",
    "description",
    "license",
    "maintainers",
    "rules",
    "false_positives"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "description": "Bundle schema version. Pinned to allow forward-compat migration."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "Globally unique bundle ID, format <category>/<bundle-name>. Must match directory location."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Human-readable bundle name shown in dashboard."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver. Bumped on any rule_ids/keywords/policy_templates change."
    },
    "status": {
      "enum": ["experimental", "stable", "deprecated"],
      "description": "Lifecycle. New bundles MUST start as 'experimental'. Promotion to 'stable' requires 30 days + telemetry."
    },
    "category": {
      "enum": [
        "coding",
        "ci-cd",
        "browser",
        "database",
        "devops",
        "email-comms",
        "customer-support",
        "payment-commerce",
        "rag-research",
        "ml-model",
        "web3-defi",
        "multi-agent",
        "compliance"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "enum": ["Apache-2.0"],
      "description": "Bundles must be Apache-2.0 to enter the public repo."
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9_/-]+$"
      },
      "description": "GitHub handles or @clampd/<team> CODEOWNERS aliases."
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "Links to vendor docs, OWASP entries, CVEs, or source research that justifies this bundle."
    },

    "sensitivity_default": {
      "enum": ["strict", "balanced", "permissive"],
      "default": "balanced"
    },
    "sensitivity_profiles": {
      "type": "object",
      "description": "Per-profile risk-score floor and action shifts. Same rules, different aggressiveness.",
      "patternProperties": {
        "^(strict|balanced|permissive)$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule_score_floor": { "type": "number", "minimum": 0, "maximum": 1 },
            "actions_promote": {
              "type": "array",
              "items": { "enum": ["flag_to_block", "warn_to_flag"] }
            },
            "actions_demote": {
              "type": "array",
              "items": { "enum": ["block_to_flag", "flag_to_warn"] }
            }
          }
        }
      },
      "additionalProperties": false
    },

    "overrideable": {
      "type": "object",
      "description": "What customers can override per-org without forking the bundle.",
      "additionalProperties": false,
      "properties": {
        "rule_action": { "type": "boolean", "default": true },
        "rule_score": { "type": "boolean", "default": true },
        "exclude_rule_ids": { "type": "boolean", "default": true },
        "fork_required_for": {
          "type": "array",
          "items": {
            "enum": ["pattern", "scope_pattern", "rule_id_set"]
          },
          "default": ["pattern", "scope_pattern"]
        }
      }
    },

    "rules": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": false,
      "properties": {
        "rule_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^R\\d{3,4}$" },
          "uniqueItems": true,
          "description": "References to BUILTIN_RULES (R001-R152+). Validated by CI."
        },
        "extra_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["regex", "field"],
            "properties": {
              "regex": { "type": "string" },
              "field": { "type": "string" }
            }
          }
        }
      }
    },

    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imports": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9/_.-]+\\.csv$" },
          "description": "Relative paths to shared CSV keyword lists in this repo."
        },
        "inline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["keyword", "category", "risk_weight"],
            "additionalProperties": false,
            "properties": {
              "keyword": { "type": "string", "minLength": 2 },
              "category": {
                "enum": [
                  "secret",
                  "pii",
                  "exfil_destination",
                  "sensitive_path",
                  "dangerous_command",
                  "exploit_signature",
                  "compliance_term",
                  "wallet_address",
                  "internal_resource"
                ]
              },
              "risk_weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "lang": { "type": "string", "default": "en" }
            }
          }
        }
      }
    },

    "demo_agents": {
      "type": "array",
      "description": "DEMO/LEARNING ONLY. Throwaway agents customers spin up to see traffic flow + understand rules. NOT a template for production. Customers create their real agents separately after onboarding. Dashboard must visibly label these as demo + suggest deleting after learning.",
      "items": {
        "type": "object",
        "required": ["name", "description", "purpose", "scopes"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*-demo$",
            "minLength": 6,
            "maxLength": 50,
            "description": "Must end in '-demo' to make purpose visible everywhere (logs, audit, dashboard list). Internal hyphens allowed."
          },
          "purpose": {
            "const": "onboarding",
            "description": "Locked. Demo agents exist for one reason: helping a new user see Clampd work end-to-end."
          },
          "description": { "type": "string", "minLength": 10 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "scopes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z]+:[a-z]+:[a-z]+$" },
            "minItems": 1,
            "description": "category:subcategory:action — must match scope_categories enum."
          },
          "boundaries": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_records_per_query": { "type": "integer", "minimum": 0 },
              "max_calls_per_minute": { "type": "integer", "minimum": 0 },
              "max_calls_per_session": { "type": "integer", "minimum": 0 },
              "max_data_volume_mb_per_hour": { "type": "number", "minimum": 0 },
              "allowed_hours_start": { "type": "integer", "minimum": 0, "maximum": 24 },
              "allowed_hours_end": { "type": "integer", "minimum": 0, "maximum": 24 },
              "allowed_hours_timezone": { "type": "string" },
              "allowed_days": { "type": "integer", "minimum": 0, "maximum": 127 },
              "auto_suspend_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
              "max_payment_per_tx_cents": { "type": "integer", "minimum": 0 },
              "max_payment_per_hour_cents": { "type": "integer", "minimum": 0 }
            }
          },
          "boundary_allowlist": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "subcategory", "pattern"],
              "additionalProperties": false,
              "properties": {
                "category": { "type": "string" },
                "subcategory": { "type": "string" },
                "pattern": { "type": "string" }
              }
            }
          },
          "example_integration": {
            "type": "object",
            "required": ["url", "language", "estimated_setup_seconds"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "language": {
                "enum": ["python", "typescript", "javascript", "go", "rust", "yaml", "shell", "bash"]
              },
              "estimated_setup_seconds": { "type": "integer", "minimum": 10, "maximum": 600 }
            }
          }
        }
      }
    },

    "protected_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "canonical", "detection_method"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "internal_domain",
              "brand_domain",
              "wallet_address",
              "phone_number",
              "api_endpoint",
              "internal_email",
              "internal_path"
            ]
          },
          "canonical": { "type": "string", "minLength": 2 },
          "detection_method": {
            "enum": ["exact_match", "typosquat", "subdomain_confusion", "pattern_match"]
          },
          "typosquat_threshold": { "type": "integer", "minimum": 1, "maximum": 4 },
          "risk_class": {
            "enum": ["internal", "financial", "brand", "generic"]
          }
        }
      }
    },

    "policy_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "cedar_template", "parameters"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 10 },
          "cedar_template": { "type": "string", "minLength": 20 },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
                "type": {
                  "enum": ["string", "integer", "number", "boolean", "string[]"]
                },
                "required": { "type": "boolean" },
                "example": {},
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "false_positives": {
      "type": "array",
      "minItems": 0,
      "description": "Document known FPs even if empty array. Force the field present.",
      "items": {
        "type": "object",
        "required": ["scenario", "remediation"],
        "additionalProperties": false,
        "properties": {
          "scenario": { "type": "string", "minLength": 20 },
          "rule_id": { "type": "string", "pattern": "^R\\d{3,4}$" },
          "remediation": { "type": "string", "minLength": 20 }
        }
      }
    },

    "backtest_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean", "default": true },
        "expected_volume_per_day": { "type": "integer", "minimum": 0 },
        "rule_ids_high_volume": {
          "type": "array",
          "items": { "type": "string", "pattern": "^R\\d{3,4}$" }
        },
        "min_sample_size": { "type": "integer", "minimum": 10, "default": 50 }
      }
    }
  }
}
