{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clampd/bundles/schema/manifest.schema.json",
  "title": "Clampd Bundles Manifest",
  "description": "Generated index of all bundles in the repo. Hand-edits are forbidden - regenerated by tools/gen-manifest on every PR merge.",
  "type": "object",
  "required": ["schema_version", "manifest_version", "generated_at", "bundles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.1" },
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
      "description": "Date-counter format YYYY-MM-DD.N"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "category", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "status": { "enum": ["experimental", "stable", "deprecated"] },
          "category": { "type": "string" },
          "path": { "type": "string", "pattern": "^bundles/[a-z0-9-]+/[a-z0-9-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "has_example": { "type": "boolean" }
        }
      }
    }
  }
}
